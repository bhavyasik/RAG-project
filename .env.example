# Required API Keys
GROQ_API_KEY= # Your GROQ API Key

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=llama-3.1-8b-instant

# Ingestion Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Retrieval Settings
K=20
BM25_WEIGHT=0.4
RRF_K=60

# Filtering Settings
K_MIN=3
MAX_PER_QUERY=8
MAX_CONTEXT_DOCS=10
SCORE_DROP_THRESHOLD=0.5
MAX_CONTEXT_CHARS=6000

# Server Settings (for API deployment)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
